{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Core Django + worker on ARM64 Fargate, RDS and HTTPS ALB. BILLABLE when deployed. No NAT gateway. Amplify SSR frontend is configured separately.",
  "Parameters": {
    "CoreImageUri": {
      "Type": "String",
      "AllowedPattern": ".+@sha256:[a-f0-9]{64}",
      "Description": "Immutable ARM64 image digest in ECR"
    },
    "CorePublicOrigin": {
      "Type": "String",
      "AllowedPattern": "https://[A-Za-z0-9.-]+",
      "Description": "Permanent public Core issuer: Amplify frontend origin"
    },
    "CoreOriginHost": {
      "Type": "String",
      "Default": "core-origin.axolotl.news",
      "AllowedPattern": "[A-Za-z0-9.-]+",
      "Description": "Cloudflare DNS-only CNAME host; covered by the ACM certificate"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:acm:.*",
      "Description": "Validated ACM certificate in THIS region for CoreOriginHost"
    },
    "CoreRuntimeSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:.*",
      "Description": "Existing JSON SecretString keys django_key, oidc_key (RSA PEM) and bootstrap_password; preserve signing keys"
    },
    "EnableCloudDeployments": {
      "Type": "String",
      "Default": "0",
      "AllowedValues": [
        "0",
        "1"
      ],
      "Description": "Allow reviewed billable cloud deployments after platform onboarding; disabled by default"
    },
    "CoreResourceCredentialsParameter": {
      "Type": "String",
      "Default": "/axolotl-news/core-resource-client",
      "AllowedPattern": "/[A-Za-z0-9_./-]+",
      "Description": "Exactly one standard SecureString parameter writable by the dedicated app-registration task"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ],
      "Description": "Keep zero until one-off migrations and first administrator bootstrap succeed"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.64.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.64.0.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet1"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "DatabaseSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.64.10.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.64.1.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet2"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "DatabaseSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.64.11.0/24",
        "MapPublicIpOnLaunch": false
      }
    },
    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS origin ingress",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8000,
            "ToPort": 8000,
            "CidrIp": "10.64.0.0/16"
          }
        ]
      }
    },
    "TaskSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Core tasks; ALB only inbound",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8000,
            "ToPort": 8000,
            "SourceSecurityGroupId": {
              "Ref": "AlbSecurityGroup"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL; Core tasks only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurityGroup"
            }
          }
        ]
      }
    },
    "TaskDatabaseEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "DestinationSecurityGroupId": {
          "Ref": "DatabaseSecurityGroup"
        }
      }
    },
    "DatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Core PostgreSQL administrator credential",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"ncecore\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 40,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "OriginSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Core proxy origin header; not Django signing keys",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private Core database subnets",
        "SubnetIds": [
          {
            "Ref": "DatabaseSubnet1"
          },
          {
            "Ref": "DatabaseSubnet2"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "DBInstanceClass": "db.t4g.micro",
        "DBName": "ncecore",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "PubliclyAccessible": false,
        "MultiAZ": false,
        "MasterUsername": "ncecore",
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${DatabaseSecret}:SecretString:password}}"
        },
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "CopyTagsToSnapshot": true,
        "AutoMinorVersionUpgrade": true
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "DatabaseSecretAttachment": {
      "Type": "AWS::SecretsManager::SecretTargetAttachment",
      "Properties": {
        "SecretId": {
          "Ref": "DatabaseSecret"
        },
        "TargetId": {
          "Ref": "Database"
        },
        "TargetType": "AWS::RDS::DBInstance"
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {}
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "CoreSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Ref": "CoreRuntimeSecretArn"
                    },
                    {
                      "Ref": "DatabaseSecret"
                    },
                    {
                      "Ref": "OriginSecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "AmplifyComputeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "amplify.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:amplify:${AWS::Region}:${AWS::AccountId}:apps/*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReadOriginHeaderOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "OriginSecret"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "256",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "web",
            "Image": {
              "Ref": "CoreImageUri"
            },
            "Essential": true,
            "Command": [
              "web"
            ],
            "Environment": [
              {
                "Name": "CORE_ISSUER",
                "Value": {
                  "Ref": "CorePublicOrigin"
                }
              },
              {
                "Name": "CORE_TRUST_PROXY",
                "Value": "1"
              },
              {
                "Name": "CORE_AWS_ORIGIN_BOUNDARY",
                "Value": "1"
              },
              {
                "Name": "CORE_ENABLE_CLOUD_DEPLOYMENTS",
                "Value": {
                  "Ref": "EnableCloudDeployments"
                }
              },
              {
                "Name": "CORE_DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "CORE_DB_NAME",
                "Value": "ncecore"
              },
              {
                "Name": "CORE_DB_USER",
                "Value": "ncecore"
              }
            ],
            "Secrets": [
              {
                "Name": "CORE_DJANGO_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${CoreRuntimeSecretArn}:django_key::"
                }
              },
              {
                "Name": "CORE_OIDC_PRIVATE_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${CoreRuntimeSecretArn}:oidc_key::"
                }
              },
              {
                "Name": "CORE_ORIGIN_SECRET",
                "ValueFrom": {
                  "Ref": "OriginSecret"
                }
              },
              {
                "Name": "CORE_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${DatabaseSecret}:password::"
                }
              }
            ],
            "MemoryReservation": 256,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "web"
              }
            },
            "PortMappings": [
              {
                "ContainerPort": 8000,
                "Protocol": "tcp"
              }
            ]
          },
          {
            "Name": "worker",
            "Image": {
              "Ref": "CoreImageUri"
            },
            "Essential": true,
            "Command": [
              "worker"
            ],
            "Environment": [
              {
                "Name": "CORE_ISSUER",
                "Value": {
                  "Ref": "CorePublicOrigin"
                }
              },
              {
                "Name": "CORE_TRUST_PROXY",
                "Value": "1"
              },
              {
                "Name": "CORE_AWS_ORIGIN_BOUNDARY",
                "Value": "1"
              },
              {
                "Name": "CORE_ENABLE_CLOUD_DEPLOYMENTS",
                "Value": {
                  "Ref": "EnableCloudDeployments"
                }
              },
              {
                "Name": "CORE_DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "CORE_DB_NAME",
                "Value": "ncecore"
              },
              {
                "Name": "CORE_DB_USER",
                "Value": "ncecore"
              }
            ],
            "Secrets": [
              {
                "Name": "CORE_DJANGO_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${CoreRuntimeSecretArn}:django_key::"
                }
              },
              {
                "Name": "CORE_OIDC_PRIVATE_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${CoreRuntimeSecretArn}:oidc_key::"
                }
              },
              {
                "Name": "CORE_ORIGIN_SECRET",
                "ValueFrom": {
                  "Ref": "OriginSecret"
                }
              },
              {
                "Name": "CORE_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${DatabaseSecret}:password::"
                }
              }
            ],
            "MemoryReservation": 256,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "worker"
              }
            }
          }
        ]
      }
    },
    "BootstrapTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "256",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "web",
            "Image": {
              "Ref": "CoreImageUri"
            },
            "Essential": true,
            "Command": [
              "bootstrap"
            ],
            "Environment": [
              {
                "Name": "CORE_ISSUER",
                "Value": {
                  "Ref": "CorePublicOrigin"
                }
              },
              {
                "Name": "CORE_TRUST_PROXY",
                "Value": "1"
              },
              {
                "Name": "CORE_AWS_ORIGIN_BOUNDARY",
                "Value": "1"
              },
              {
                "Name": "CORE_ENABLE_CLOUD_DEPLOYMENTS",
                "Value": {
                  "Ref": "EnableCloudDeployments"
                }
              },
              {
                "Name": "CORE_DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "CORE_DB_NAME",
                "Value": "ncecore"
              },
              {
                "Name": "CORE_DB_USER",
                "Value": "ncecore"
              }
            ],
            "Secrets": [
              {
                "Name": "CORE_DJANGO_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${CoreRuntimeSecretArn}:django_key::"
                }
              },
              {
                "Name": "CORE_OIDC_PRIVATE_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${CoreRuntimeSecretArn}:oidc_key::"
                }
              },
              {
                "Name": "CORE_ORIGIN_SECRET",
                "ValueFrom": {
                  "Ref": "OriginSecret"
                }
              },
              {
                "Name": "CORE_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${DatabaseSecret}:password::"
                }
              },
              {
                "Name": "CORE_BOOTSTRAP_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${CoreRuntimeSecretArn}:bootstrap_password::"
                }
              }
            ],
            "MemoryReservation": 256,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "web"
              }
            },
            "PortMappings": [
              {
                "ContainerPort": 8000,
                "Protocol": "tcp"
              }
            ]
          }
        ]
      }
    },
    "RegistrationTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WriteAxolotlResourceCredentialOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ssm:PutParameter",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${CoreResourceCredentialsParameter}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "kms:Encrypt",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kms:${AWS::Region}:${AWS::AccountId}:key/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com"
                      },
                      "kms:EncryptionContext:PARAMETER_ARN": {
                        "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${CoreResourceCredentialsParameter}"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "RegistrationTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "256",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "RegistrationTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "web",
            "Image": {
              "Ref": "CoreImageUri"
            },
            "Essential": true,
            "Command": [
              "manage",
              "register_external_application"
            ],
            "Environment": [
              {
                "Name": "CORE_ISSUER",
                "Value": {
                  "Ref": "CorePublicOrigin"
                }
              },
              {
                "Name": "CORE_TRUST_PROXY",
                "Value": "1"
              },
              {
                "Name": "CORE_AWS_ORIGIN_BOUNDARY",
                "Value": "1"
              },
              {
                "Name": "CORE_ENABLE_CLOUD_DEPLOYMENTS",
                "Value": {
                  "Ref": "EnableCloudDeployments"
                }
              },
              {
                "Name": "CORE_DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "CORE_DB_NAME",
                "Value": "ncecore"
              },
              {
                "Name": "CORE_DB_USER",
                "Value": "ncecore"
              },
              {
                "Name": "CORE_REGISTRATION_SSM_PARAMETER",
                "Value": {
                  "Ref": "CoreResourceCredentialsParameter"
                }
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              }
            ],
            "Secrets": [
              {
                "Name": "CORE_DJANGO_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${CoreRuntimeSecretArn}:django_key::"
                }
              },
              {
                "Name": "CORE_OIDC_PRIVATE_KEY",
                "ValueFrom": {
