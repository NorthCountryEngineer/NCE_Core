{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "FixedReleaseRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:015454941623:repository/nce-proposal-web",
        "arn:aws:ecr:us-east-1:015454941623:repository/nce-family-proposal-api",
        "arn:aws:ecr:us-east-1:015454941623:repository/nce-family-proposal-browser",
        "arn:aws:ecr:us-east-1:015454941623:repository/nce/proposal-studio"
      ]
    },
    {
      "Sid": "ReleaseEvidenceOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::nce-family-cloud-platform-artifacts-u7go6eehrq5w/oci-releases/proposal-studio/*"
    },
    {
      "Sid": "ReleaseBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::nce-family-cloud-platform-artifacts-u7go6eehrq5w"
    },
    {
      "Sid": "ReleaseSigningOnly",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetPublicKey",
        "kms:Sign",
        "kms:Verify"
      ],
      "Resource": "arn:aws:kms:us-east-1:015454941623:key/808040ff-0728-4996-b3bd-757609d6b943"
    },
    {
      "Sid": "BuildLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:015454941623:log-group:/aws/codebuild/nce-proposal-oci-release:*"
    },
    {
      "Sid": "ReadTwoRepositories",
      "Effect": "Allow",
      "Action": "codeconnections:UseConnection",
      "Resource": "arn:aws:codeconnections:us-east-1:015454941623:connection/1ac24555-2c7b-4367-bb11-3697083ee414",
      "Condition": {
        "StringEquals": {
          "codeconnections:FullRepositoryId": [
            "NorthCountryEngineer/NCE_Core",
            "NorthCountryEngineer/Proposal_Studio"
          ]
        },
        "StringEqualsIfExists": {
          "codeconnections:ProviderPermissionsRequired": "read_only",
          "codeconnections:ProviderAction": [
            "GitPull",
            "GetRepository",
            "GetBranch",
            "GetCommit",
            "GetFile",
            "ListBranches"
          ]
        }
      }
    },
    {
      "Sid": "NativeCodeBuildConnectionToken",
      "Effect": "Allow",
      "Action": [
        "codeconnections:GetConnection",
        "codeconnections:GetConnectionToken"
      ],
      "Resource": "arn:aws:codeconnections:us-east-1:015454941623:connection/1ac24555-2c7b-4367-bb11-3697083ee414"
    }
  ]
}
