{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccountAdministration",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::015454941623:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "IsolatedBuildLogs",
      "Effect": "Allow",
      "Principal": {
        "Service": "logs.us-east-1.amazonaws.com"
      },
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "kms:EncryptionContext:aws:logs:arn": "arn:aws:logs:us-east-1:015454941623:log-group:/aws/codebuild/nce-proposal-oci-release"
        }
      }
    }
  ]
}
