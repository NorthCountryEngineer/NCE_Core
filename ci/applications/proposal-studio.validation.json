{
  "external": {
    "databaseCredentialRef": "nce-app-db",
    "runtimeCredentialRef": "nce-app-runtime",
    "pullSecrets": [],
    "apiEnvironment": {
      "APP_URL": "https://proposal.example.invalid",
      "AUTH_MODE": "github",
      "STORAGE_BACKEND": "s3",
      "S3_AUTH_MODE": "role",
      "S3_ENDPOINT": "",
      "S3_REGION": "us-east-1",
      "S3_BUCKET": "nce-proposal-artifacts",
      "S3_ADDRESSING_STYLE": "auto",
      "PLATFORM_ADMIN_USERS": "approved-operator"
    },
    "apiEnvFromKeys": [],
    "externalEgressCIDRs": []
  },
  "ingress": {
    "enabled": true,
    "className": "nginx",
    "host": "proposal.example.invalid",
    "tlsRef": "nce-app-tls"
  },
  "networkPolicy": {
    "enabled": true,
    "ingressNamespaceSelector": {
      "kubernetes.io/metadata.name": "ingress-nginx"
    },
    "ingressPodSelector": {
      "app.kubernetes.io/name": "ingress-nginx"
    },
    "browserPublicEgress": false
  }
}
