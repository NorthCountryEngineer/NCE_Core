{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application",
    "runner_release_branch",
    "registry",
    "chart",
    "images",
    "values",
    "validation_values_file",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,52}[a-z0-9]$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
        }
      }
    },
    "runner_release_branch": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]{0,120}$"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "region",
        "chart_repository",
        "release_bucket"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$"
        },
        "chart_repository": {
          "type": "string",
          "minLength": 25
        },
        "release_bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "base_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,52}[a-z0-9]$"
        },
        "base_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "images": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 5,
      "required": [
        "web",
        "api",
        "browser"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "dockerfile"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 30
          },
          "dockerfile": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.\\/-]+$"
          }
        }
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workloads",
        "external",
        "ingress",
        "networkPolicy"
      ],
      "properties": {
        "workloads": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "replicas",
              "readinessPath",
              "memory",
              "cpu"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "replicas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "readinessPath": {
                "type": "string",
                "pattern": "^/[a-zA-Z0-9/_-]*$"
              },
              "memory": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(Mi|Gi)$"
              },
              "cpu": {
                "type": "string",
                "pattern": "^[1-9][0-9]*m$"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              }
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "databaseSecret",
            "runtimeSecret",
            "pullSecrets",
            "apiEnvironment",
            "apiSecretKeys",
            "externalEgressCIDRs"
          ],
          "properties": {
            "databaseSecret": {
              "type": "string",
              "minLength": 1
            },
            "runtimeSecret": {
              "type": "string",
              "minLength": 1
            },
            "pullSecrets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "apiEnvironment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "apiSecretKeys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "externalEgressCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "referenceLibraryClaim": {
              "type": "string"
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "className",
            "host",
            "tlsSecret"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "tlsSecret": {
              "type": "string"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "ingressNamespaceSelector",
            "ingressPodSelector",
            "browserPublicEgress"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ingressNamespaceSelector": {
              "type": "object"
            },
            "ingressPodSelector": {
              "type": "object"
            },
            "browserPublicEgress": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "validation_values_file": {
      "type": "string",
      "pattern": "^ci/applications/[a-zA-Z0-9_./-]+\\.json$"
    },
    "require_signatures": {
      "type": "boolean"
    },
    "require_sbom": {
      "type": "boolean"
    },
    "environment": {
      "type": "string",
      "enum": [
        "staging",
        "production",
        "development",
        "uat",
        "sandbox"
      ]
    }
  }
}
