{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "releaseIdentity",
    "workloads",
    "external",
    "ingress",
    "networkPolicy"
  ],
  "properties": {
    "images": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9_./-]+@sha256:[a-f0-9]{64}$"
      }
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "runnerCommit"
      ],
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runnerCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "workloads": {
      "type": "object",
      "required": [
        "web",
        "api",
        "browser"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "port",
          "replicas",
          "readinessPath",
          "memory",
          "cpu"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "readinessPath": {
            "type": "string",
            "pattern": "^/[a-zA-Z0-9/_-]*$"
          },
          "memory": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(Mi|Gi)$"
          },
          "cpu": {
            "type": "string",
            "pattern": "^[1-9][0-9]*m$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          }
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseSecret",
        "runtimeSecret",
        "pullSecrets",
        "apiEnvironment",
        "apiSecretKeys",
        "externalEgressCIDRs"
      ],
      "properties": {
        "databaseSecret": {
          "type": "string",
          "minLength": 1
        },
        "runtimeSecret": {
          "type": "string",
          "minLength": 1
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "apiEnvironment": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "apiSecretKeys": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,80}$"
          },
          "uniqueItems": true
        },
        "externalEgressCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 7,
            "maxLength": 49
          },
          "uniqueItems": true
        },
        "referenceLibraryClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host",
        "tlsSecret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tlsSecret": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressNamespaceSelector",
        "ingressPodSelector",
        "browserPublicEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaceSelector": {
          "type": "object"
        },
        "ingressPodSelector": {
          "type": "object"
        },
        "browserPublicEgress": {
          "type": "boolean"
        }
      }
    }
  }
}
