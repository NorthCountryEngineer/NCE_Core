{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "releaseIdentity",
    "workloads",
    "external",
    "ingress",
    "networkPolicy"
  ],
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web",
        "api",
        "browser"
      ],
      "properties": {
        "web": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9_./-]+@sha256:[a-f0-9]{64}$"
        },
        "api": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9_./-]+@sha256:[a-f0-9]{64}$"
        },
        "browser": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9_./-]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "runnerCommit"
      ],
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runnerCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web",
        "api",
        "browser"
      ],
      "properties": {
        "web": {
          "allOf": [
            {
              "$ref": "#/definitions/workload"
            },
            {
              "properties": {
                "port": {
                  "const": 8080
                },
                "readinessPath": {
                  "const": "/health"
                }
              }
            }
          ]
        },
        "api": {
          "allOf": [
            {
              "$ref": "#/definitions/workload"
            },
            {
              "properties": {
                "port": {
                  "const": 8000
                },
                "readinessPath": {
                  "const": "/api/health"
                },
                "replicas": {
                  "const": 1
                }
              }
            }
          ]
        },
        "browser": {
          "allOf": [
            {
              "$ref": "#/definitions/workload"
            },
            {
              "properties": {
                "port": {
                  "const": 8010
                },
                "readinessPath": {
                  "const": "/health"
                },
                "replicas": {
                  "const": 1
                }
              }
            }
          ]
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseCredentialRef",
        "runtimeCredentialRef",
        "pullSecrets",
        "apiEnvironment",
        "apiEnvFromKeys",
        "externalEgressCIDRs"
      ],
      "properties": {
        "databaseCredentialRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "runtimeCredentialRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          },
          "uniqueItems": true
        },
        "apiEnvironment": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          },
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[A-Z][A-Z0-9_]{0,80}$"
              },
              {
                "not": {
                  "pattern": "SECRET|PASSWORD|TOKEN|CREDENTIAL|PRIVATE_KEY|ACCESS_KEY"
                }
              },
              {
                "not": {
                  "enum": [
                    "DATABASE_URL",
                    "SESSION_SECRET",
                    "SAM_BROWSER_URL",
                    "WEB_CONCURRENCY"
                  ]
                }
              }
            ]
          }
        },
        "apiEnvFromKeys": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,80}$",
            "not": {
              "enum": [
                "DATABASE_URL",
                "SESSION_SECRET",
                "SAM_BROWSER_URL",
                "WEB_CONCURRENCY"
              ]
            }
          },
          "uniqueItems": true
        },
        "externalEgressCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 7,
            "maxLength": 49
          },
          "uniqueItems": true
        },
        "referenceLibraryClaim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host",
        "tlsRef"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tlsRef": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressNamespaceSelector",
        "ingressPodSelector",
        "browserPublicEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaceSelector": {
          "type": "object",
          "minProperties": 1
        },
        "ingressPodSelector": {
          "type": "object",
          "minProperties": 1
        },
        "browserPublicEgress": {
          "type": "boolean"
        },
        "dnsNamespaceSelector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "dnsPodSelector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "replicas",
        "readinessPath",
        "memory",
        "cpu"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "readinessPath": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9/_-]*$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        },
        "cpu": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,2}|1000)m$"
        }
      }
    }
  }
}
